# ==============================================================================
# Hướng dẫn: Sao chép tệp này sang .env và chỉnh sửa theo môi trường thực tế:
#   cp .env.example .env
# ==============================================================================

# Cổng truy cập dịch vụ Backend trên máy Host
PORT=8080

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_PORT=5432
